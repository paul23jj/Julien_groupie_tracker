}

.barre-recherche {
    background-color: #1B2838;
}

.boutton-recherche {
  background: transparent;
  border: none;
  padding: 0;
  cursor: pointer;
}

.boutton-recherche {
  mix-blend-mode: multiply;
  display: block;
}

body {
    color: white;
    font-family: Arial, sans-serif;
    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.7);
    padding: 20px;
    background: linear-gradient(135deg, #171A21 0%, #1B2838 100%);
    min-height: 100vh;
    }